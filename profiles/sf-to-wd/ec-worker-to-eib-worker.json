{
  "profileId": "sf-ec-worker-to-wd-eib-worker",
  "description": "SAP SuccessFactors Employee Central → Workday EIB Worker (Flat Sheet). Starter profile with pre-configured standard field mappings. Ready to run against a standard SF EC export with zero manual configuration for universal fields. Client-specific lookup tables (cost centre, org unit, location) must be filled in before use.",
  "version": "1.0",
  "createdAt": "2026-02-26",
  "updatedAt": "2026-02-26",
  "author": "SF2WD Team",
  "source": {
    "system": "sap-successfactors",
    "template": "ec-employee-export"
  },
  "target": {
    "system": "workday",
    "template": "eib-worker"
  },
  "settings": {
    "onValidationError": "skip",
    "dateLocale": "en-US",
    "emptySourceValue": ["", null, "NULL", "N/A", "n/a"],
    "enableExprRules": false
  },
  "lookupTables": {
    "gender": {
      "M": "Male",
      "F": "Female",
      "U": "Not Declared",
