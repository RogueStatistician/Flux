# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# JWT signing secrets — generate with: openssl rand -hex 32
# Both must be at least 32 characters.
JWT_ACCESS_SECRET=replace_with_32_plus_char_random_string
JWT_REFRESH_SECRET=replace_with_different_32_plus_char_random_string

# Set to any non-empty value when the server is behind HTTPS (enables Secure cookie flag).
# Leave unset for HTTP-only local development.
# HTTPS=true

# Required in production: the exact origin that browsers connect from.
# In production with Express serving the static files this is same-origin,
# but set it anyway to satisfy the startup check.
# Example: CORS_ORIGIN=https://flux.yourcompany.com
CORS_ORIGIN=http://localhost:5173

# Optional: path to the users SQLite database (default: ~/.flux/users.db)
# USERS_DB_PATH=/data/users.db

# Optional: admin recovery bootstrap token.
# If set, POST /auth/register with header X-Bootstrap-Token: <value> creates
# an admin user even when other users already exist.
# Use only for emergency admin recovery. Clear after use.
# ADMIN_BOOTSTRAP_TOKEN=
