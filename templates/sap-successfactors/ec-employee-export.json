{
  "systemId": "sap-successfactors",
  "templateId": "ec-employee-export",
  "displayName": "SAP SuccessFactors Employee Central — Worker Export",
  "description": "Standard SuccessFactors EC employee export format. Contains core worker biographical and employment data.",
  "version": "1.0",
  "role": "source",
  "fields": [
    { "name": "PERNR",      "displayName": "Personnel Number",         "type": "string",  "required": true,  "description": "Unique employee identifier in SAP" },
    { "name": "FIRSTNAME",  "displayName": "First Name",               "type": "string",  "required": true },
    { "name": "LASTNAME",   "displayName": "Last Name",                "type": "string",  "required": true },
    { "name": "MIDNAME",    "displayName": "Middle Name",              "type": "string",  "required": false },
    { "name": "PREFIX",     "displayName": "Name Prefix",              "type": "string",  "required": false },
    { "name": "GENDER",     "displayName": "Gender",                   "type": "string",  "required": false, "description": "M / F / U or system code" },
    { "name": "BIRTHDT",    "displayName": "Date of Birth",            "type": "date",    "required": false, "dateFormat": "YYYYMMDD" },
    { "name": "NATID",      "displayName": "National ID",              "type": "string",  "required": false },
    { "name": "EINDT",      "displayName": "Hire Date",                "type": "date",    "required": true,  "dateFormat": "YYYYMMDD" },
    { "name": "AUSDT",      "displayName": "Termination Date",         "type": "date",    "required": false, "dateFormat": "YYYYMMDD" },
    { "name": "PERSK",      "displayName": "Employee Sub-Group",       "type": "string",  "required": false, "description": "Contract type code (e.g. 1=Regular, 2=Contractor)" },
    { "name": "EMPST",      "displayName": "Employment Status",        "type": "string",  "required": false },
    { "name": "VDSK1",      "displayName": "Full-Time/Part-Time",      "type": "string",  "required": false, "description": "1=Full-Time, 2=Part-Time" },
    { "name": "BTZEI",      "displayName": "FTE Percentage",           "type": "decimal", "required": false, "description": "As a decimal, e.g. 1.0 = 100%, 0.5 = 50%" },
    { "name": "ORGEH",      "displayName": "Organisational Unit ID",   "type": "string",  "required": false },
    { "name": "PLANS",      "displayName": "Position ID",              "type": "string",  "required": false },
    { "name": "STELL",      "displayName": "Job Title",                "type": "string",  "required": false },
    { "name": "WERKS",      "displayName": "Personnel Area (Location)","type": "string",  "required": false },
    { "name": "LAND1",      "displayName": "Country Code",             "type": "string",  "required": false, "description": "ISO 3166-1 alpha-2 (DE, FR, GB...)" },
    { "name": "BUKRS",      "displayName": "Company Code",             "type": "string",  "required": false },
    { "name": "KOSTL",      "displayName": "Cost Centre",              "type": "string",  "required": false },
    { "name": "MANAGER_PERNR", "displayName": "Manager Personnel Number", "type": "string", "required": false },
    { "name": "EMAIL",      "displayName": "Work Email Address",       "type": "string",  "required": false },
    { "name": "PHONE",      "displayName": "Work Phone Number",        "type": "string",  "required": false },
    { "name": "MONTHLY_SALARY", "displayName": "Monthly Salary",      "type": "decimal", "required": false },
    { "name": "CURRENCY",   "displayName": "Salary Currency",          "type": "string",  "required": false }
  ]
}
