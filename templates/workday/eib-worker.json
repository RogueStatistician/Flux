{
  "systemId": "workday",
  "templateId": "eib-worker",
  "displayName": "Workday EIB — Worker (Flat Sheet)",
  "description": "Workday Enterprise Interface Builder flat-sheet format for importing workers. Single tab, Workday-mandated headers in row 1.",
  "version": "2024.1",
  "role": "target",
  "structure": "flat",
  "fields": [
    { "name": "Employee_ID",           "displayName": "Employee ID",               "type": "string",  "required": true,  "maxLength": 35,  "description": "Unique worker identifier in Workday" },
    { "name": "First_Name",            "displayName": "First Name",                "type": "string",  "required": true,  "maxLength": 100 },
    { "name": "Last_Name",             "displayName": "Last Name",                 "type": "string",  "required": true,  "maxLength": 100 },
    { "name": "Middle_Name",           "displayName": "Middle Name",               "type": "string",  "required": false, "maxLength": 100 },
    { "name": "Preferred_Name",        "displayName": "Preferred Name",            "type": "string",  "required": false, "maxLength": 100 },
    { "name": "Gender",                "displayName": "Gender",                    "type": "picklist","required": false, "allowedValues": ["Male", "Female", "Not Declared"], "description": "Workday gender reference" },
    { "name": "Date_of_Birth",         "displayName": "Date of Birth",             "type": "date",    "required": false, "dateFormat": "MM/DD/YYYY" },
    { "name": "National_ID",           "displayName": "National ID",               "type": "string",  "required": false, "maxLength": 50 },
    { "name": "Hire_Date",             "displayName": "Hire Date",                 "type": "date",    "required": true,  "dateFormat": "MM/DD/YYYY" },
    { "name": "Termination_Date",      "displayName": "Termination Date",          "type": "date",    "required": false, "dateFormat": "MM/DD/YYYY" },
    { "name": "Contract_Type",         "displayName": "Contract Type",             "type": "picklist","required": false, "allowedValues": ["Regular", "Contractor", "Intern", "Temporary"] },
    { "name": "Employment_Status",     "displayName": "Employment Status",         "type": "picklist","required": false, "allowedValues": ["Active", "Inactive", "Leave of Absence"] },
    { "name": "FTE_Type",              "displayName": "FTE Type",                  "type": "picklist","required": false, "allowedValues": ["Full-Time", "Part-Time"] },
    { "name": "FTE_Percent",           "displayName": "FTE %",                     "type": "decimal", "required": false, "description": "As a percentage value, e.g. 100 or 50" },
    { "name": "Organisation_Unit",     "displayName": "Organisation Unit",         "type": "string",  "required": false, "maxLength": 100, "description": "Workday Organisation Unit reference ID" },
    { "name": "Position_ID",           "displayName": "Position ID",               "type": "string",  "required": false, "maxLength": 50 },
    { "name": "Job_Title",             "displayName": "Job Title",                 "type": "string",  "required": false, "maxLength": 200 },
    { "name": "Location",              "displayName": "Location",                  "type": "string",  "required": false, "maxLength": 100, "description": "Workday Location reference ID" },
    { "name": "Country",               "displayName": "Country",                   "type": "string",  "required": false, "maxLength": 100, "description": "Workday Country reference (e.g. 'Germany', 'France')" },
    { "name": "Company",               "displayName": "Company",                   "type": "string",  "required": false, "maxLength": 100 },
    { "name": "Cost_Center",           "displayName": "Cost Center",               "type": "string",  "required": false, "maxLength": 50 },
    { "name": "Manager_ID",            "displayName": "Manager Employee ID",       "type": "string",  "required": false, "maxLength": 35 },
    { "name": "Email_Address",         "displayName": "Email Address",             "type": "string",  "required": false, "maxLength": 250 },
    { "name": "Phone_Number",          "displayName": "Phone Number",              "type": "string",  "required": false, "maxLength": 50 },
    { "name": "Annual_Salary",         "displayName": "Annual Salary",             "type": "decimal", "required": false },
    { "name": "Salary_Currency",       "displayName": "Salary Currency",           "type": "string",  "required": false, "maxLength": 3, "description": "ISO 4217 currency code" },
    { "name": "Source_System",         "displayName": "Source System",             "type": "string",  "required": false, "maxLength": 50, "description": "Populated by SF2WD for audit purposes" }
  ]
}
